(ns itonami.app.entry
  "Umisachi on the device (AWAI-3502). Calls umisachi.methods.analyze
  unchanged: load-graph (with the G1/G4 charter guard), analyze, rank and the
  report. Live ingest is G7/Council-gated and is not offered. The example is
  the repo's seed graph (data/seed-umisachi-graph.kotoba.edn)."
  (:require [itonami.app.run :as run]
            [umisachi.methods.analyze :as a]))

(def ^:private seed ";; umisachi 海幸 — seafood / marine-bounty KG mirror seed (ADR-2606074200).\n;; PUBLIC, :representative / :authoritative marine-provisioning graph.\n;;\n;; G1 — NOURISHMENT / RESTORATION map, NEVER a catch-target list. NO stock coordinates,\n;;       NO fishing-ground GPS, NO \"where the fish are\" (coordinate-shaped keys are refused\n;;       at load). Regions are coarse FAO major-area NAMES only.\n;; G2 — edge-primary (N1). 取 (extraction/depletion) lives ONLY on edges (:en/load); a stock's\n;;       depletion = Σ incident inbound :depletes/:encloses, computed on read. No stored score.\n;; G3 — non-adjudicating (N3). :stock/status, :market/access are DISCLOSED facts\n;;       (FAO/RAM/ICES/IUCN/CCAMLR/ICCAT/MSC), never umisachi verdicts.\n;; G4 — factory-fishing / IUU / bottom-trawl are UNREPRESENTABLE as a :fishery method. They\n;;       may appear ONLY as a :pressure node (the disclosed harm borne), routed to restoration.\n;;\n;; node kinds: :stock :fishery :logistics :market :pressure\n;; edge kinds (provisioning): :provisions :nourishes :stewards :restores :cultivates\n;;            (depletion):     :depletes :encloses :gates\n[\n ;; ── stocks (DISCLOSED status; region = coarse FAO area NAME, never coordinates) ──\n {:organism/id :stock.skipjack-wcpo  :organism/kind :stock :organism/label \"Pacific skipjack tuna (WCPO)\"\n  :organism/sourcing :authoritative :stock/species \"Katsuwonus pelamis\"\n  :stock/status :sustainable :stock/region \"FAO-71 Western-Central Pacific\"}\n {:organism/id :stock.bluefin-pacific :organism/kind :stock :organism/label \"Pacific bluefin tuna\"\n  :organism/sourcing :authoritative :stock/species \"Thunnus orientalis\"\n  :stock/status :recovering :stock/region \"FAO-61/77 Pacific\"}\n {:organism/id :stock.sardine-japan :organism/kind :stock :organism/label \"Japanese sardine (maiwashi)\"\n  :organism/sourcing :authoritative :stock/species \"Sardinops melanostictus\"\n  :stock/status :fully-fished :stock/region \"FAO-61 Northwest Pacific\"}\n {:organism/id :stock.pollock-bering :organism/kind :stock :organism/label \"Alaska pollock (Bering Sea)\"\n  :organism/sourcing :authoritative :stock/species \"Gadus chalcogrammus\"\n  :stock/status :sustainable :stock/region \"FAO-67 Northeast Pacific\"}\n {:organism/id :stock.cod-northsea :organism/kind :stock :organism/label \"Atlantic cod (North Sea)\"\n  :organism/sourcing :authoritative :stock/species \"Gadus morhua\"\n  :stock/status :recovering :stock/region \"FAO-27 Northeast Atlantic\"}\n {:organism/id :stock.eel-japanese :organism/kind :stock :organism/label \"Japanese eel (unagi, IUCN EN)\"\n  :organism/sourcing :authoritative :stock/species \"Anguilla japonica\"\n  :stock/status :depleted :stock/region \"FAO-61 Northwest Pacific\"}\n {:organism/id :stock.krill-antarctic :organism/kind :stock :organism/label \"Antarctic krill (CCAMLR)\"\n  :organism/sourcing :authoritative :stock/species \"Euphausia superba\"\n  :stock/status :fully-fished :stock/region \"FAO-48 Antarctic Atlantic\"}\n {:organism/id :stock.sanma-pacific :organism/kind :stock :organism/label \"Pacific saury (sanma, NPFC)\"\n  :organism/sourcing :authoritative :stock/species \"Cololabis saira\"\n  :stock/status :overfished :stock/region \"FAO-61 Northwest Pacific\"}\n {:organism/id :stock.kombu-hokkaido :organism/kind :stock :organism/label \"Hokkaido kelp (kombu)\"\n  :organism/sourcing :representative :stock/species \"Saccharina japonica\"\n  :stock/status :sustainable :stock/region \"FAO-61 Northwest Pacific\"}\n {:organism/id :stock.oyster-hiroshima :organism/kind :stock :organism/label \"Pacific oyster (cultured)\"\n  :organism/sourcing :representative :stock/species \"Magallana gigas\"\n  :stock/status :sustainable :stock/region \"FAO-61 Northwest Pacific\"}\n\n ;; ── fisheries / aquaculture (SUSTAINABLE methods ONLY — G4) ──\n {:organism/id :fishery.poleline-skipjack :organism/kind :fishery :organism/label \"Pole-and-line skipjack\"\n  :organism/sourcing :representative :fishery/method :pole-line :fishery/scale :artisanal}\n {:organism/id :fishery.setnet-coastal :organism/kind :fishery :organism/label \"Coastal set-net (定置網)\"\n  :organism/sourcing :representative :fishery/method :set-net :fishery/scale :community}\n {:organism/id :fishery.kombu-farm :organism/kind :fishery :organism/label \"Kombu seaweed farm\"\n  :organism/sourcing :representative :fishery/method :seaweed-culture :fishery/scale :community}\n {:organism/id :fishery.oyster-raft :organism/kind :fishery :organism/label \"Oyster raft culture\"\n  :organism/sourcing :representative :fishery/method :shellfish-culture :fishery/scale :community}\n {:organism/id :fishery.imta-site :organism/kind :fishery :organism/label \"Integrated multi-trophic aquaculture\"\n  :organism/sourcing :representative :fishery/method :imta :fishery/scale :community}\n {:organism/id :fishery.ras-landbased :organism/kind :fishery :organism/label \"Land-based recirculating aquaculture\"\n  :organism/sourcing :representative :fishery/method :recirculating-aquaculture :fishery/scale :industrial}\n\n ;; ── logistics (cold-chain / port / processing / distribution / market-hall) ──\n {:organism/id :logi.coldchain-reefer :organism/kind :logistics :organism/label \"Reefer cold-chain corridor\"\n  :organism/sourcing :representative :logistics/kind :cold-chain}\n {:organism/id :logi.toyosu-market :organism/kind :logistics :organism/label \"Toyosu wholesale market\"\n  :organism/sourcing :authoritative :logistics/kind :market-hall}\n {:organism/id :logi.regional-port :organism/kind :logistics :organism/label \"Regional fishing port\"\n  :organism/sourcing :representative :logistics/kind :port}\n {:organism/id :logi.processing-plant :organism/kind :logistics :organism/label \"Coastal processing plant\"\n  :organism/sourcing :representative :logistics/kind :processing}\n\n ;; ── markets / consumption (access category = DISCLOSED, provisioning-equity weight) ──\n {:organism/id :market.local-commons :organism/kind :market :organism/label \"Local commons market\"\n  :organism/sourcing :representative :market/kind :local :market/access :commons}\n {:organism/id :market.domestic-regulated :organism/kind :market :organism/label \"Domestic regulated market\"\n  :organism/sourcing :representative :market/kind :domestic :market/access :regulated}\n {:organism/id :market.export-sushi :organism/kind :market :organism/label \"Export sushi-grade channel\"\n  :organism/sourcing :representative :market/kind :export :market/access :proprietary}\n\n ;; ── pressures (DISCLOSED harms — the 取 borne, routed to RESTORATION; never an endorsed method) ──\n {:organism/id :pressure.industrial-overfishing :organism/kind :pressure :organism/label \"Industrial overfishing\"\n  :organism/sourcing :representative :pressure/kind :overfishing\n  :pressure/links \"tsumugi:org.corp.distant-water-fleet\"}\n {:organism/id :pressure.iuu-fishing :organism/kind :pressure :organism/label \"IUU fishing (FAO-recognized)\"\n  :organism/sourcing :authoritative :pressure/kind :iuu}\n {:organism/id :pressure.bottom-trawl :organism/kind :pressure :organism/label \"Bottom-trawl habitat damage\"\n  :organism/sourcing :representative :pressure/kind :habitat-loss}\n {:organism/id :pressure.ocean-warming :organism/kind :pressure :organism/label \"Ocean warming (IPCC)\"\n  :organism/sourcing :authoritative :pressure/kind :warming}\n {:organism/id :pressure.acidification :organism/kind :pressure :organism/label \"Ocean acidification (IPCC)\"\n  :organism/sourcing :authoritative :pressure/kind :acidification}\n {:organism/id :pressure.bycatch :organism/kind :pressure :organism/label \"Non-target bycatch\"\n  :organism/sourcing :representative :pressure/kind :bycatch}\n {:organism/id :pressure.distribution-monopoly :organism/kind :pressure :organism/label \"Distribution monopoly\"\n  :organism/sourcing :representative :pressure/kind :monopoly\n  :pressure/links \"kabuto:org.corp.seafood-distributor\"}\n {:organism/id :pressure.factory-fishing :organism/kind :pressure :organism/label \"Factory-fishing (disclosed harm)\"\n  :organism/sourcing :representative :pressure/kind :factory-fishing}\n\n ;; ── 縁 : provisioning / stewardship (routed to NOURISHMENT) ──\n {:en/from :fishery.poleline-skipjack :en/to :logi.coldchain-reefer :en/kind :provisions :en/load 0.7 :en/sourcing :representative}\n {:en/from :fishery.poleline-skipjack :en/to :market.local-commons    :en/kind :nourishes  :en/load 0.5 :en/sourcing :representative}\n {:en/from :fishery.setnet-coastal    :en/to :market.local-commons    :en/kind :nourishes  :en/load 0.8 :en/sourcing :representative}\n {:en/from :fishery.kombu-farm        :en/to :stock.kombu-hokkaido    :en/kind :cultivates :en/load 0.9 :en/sourcing :representative}\n {:en/from :fishery.kombu-farm        :en/to :stock.kombu-hokkaido    :en/kind :stewards   :en/load 0.6 :en/sourcing :representative}\n {:en/from :fishery.oyster-raft       :en/to :stock.oyster-hiroshima  :en/kind :cultivates :en/load 0.9 :en/sourcing :representative}\n {:en/from :fishery.imta-site         :en/to :stock.oyster-hiroshima  :en/kind :restores   :en/load 0.4 :en/sourcing :representative}\n {:en/from :fishery.ras-landbased     :en/to :market.domestic-regulated :en/kind :provisions :en/load 0.6 :en/sourcing :representative}\n {:en/from :logi.coldchain-reefer     :en/to :market.export-sushi     :en/kind :provisions :en/load 0.8 :en/sourcing :representative}\n {:en/from :logi.regional-port        :en/to :logi.toyosu-market      :en/kind :provisions :en/load 0.7 :en/sourcing :representative}\n {:en/from :logi.toyosu-market        :en/to :market.domestic-regulated :en/kind :provisions :en/load 0.7 :en/sourcing :representative}\n {:en/from :logi.processing-plant     :en/to :market.local-commons    :en/kind :provisions :en/load 0.5 :en/sourcing :representative}\n\n ;; ── 縁 : depletion / enclosure (the 取 borne — routed to RESTORATION) ──\n {:en/from :pressure.industrial-overfishing :en/to :stock.sanma-pacific   :en/kind :depletes :en/load 0.9 :en/sourcing :representative}\n {:en/from :pressure.industrial-overfishing :en/to :stock.sardine-japan   :en/kind :depletes :en/load 0.6 :en/sourcing :representative}\n {:en/from :pressure.industrial-overfishing :en/to :stock.krill-antarctic :en/kind :depletes :en/load 0.4 :en/sourcing :representative}\n {:en/from :pressure.iuu-fishing            :en/to :stock.bluefin-pacific :en/kind :depletes :en/load 0.8 :en/sourcing :authoritative}\n {:en/from :pressure.factory-fishing        :en/to :stock.pollock-bering  :en/kind :depletes :en/load 0.5 :en/sourcing :representative}\n {:en/from :pressure.bottom-trawl           :en/to :stock.cod-northsea    :en/kind :depletes :en/load 0.7 :en/sourcing :representative}\n {:en/from :pressure.bycatch                :en/to :stock.eel-japanese    :en/kind :depletes :en/load 0.5 :en/sourcing :representative}\n {:en/from :pressure.ocean-warming          :en/to :stock.sanma-pacific   :en/kind :depletes :en/load 0.6 :en/sourcing :authoritative}\n {:en/from :pressure.acidification          :en/to :stock.oyster-hiroshima :en/kind :depletes :en/load 0.4 :en/sourcing :authoritative}\n {:en/from :pressure.distribution-monopoly  :en/to :market.export-sushi   :en/kind :encloses :en/load 0.8 :en/sourcing :representative}\n {:en/from :pressure.distribution-monopoly  :en/to :market.local-commons  :en/kind :gates    :en/load 0.5 :en/sourcing :representative}\n {:en/from :pressure.factory-fishing        :en/to :market.export-sushi   :en/kind :encloses :en/load 0.4 :en/sourcing :representative}\n]\n")

(run/register!
 {:name "analyze" :label "グラフを読み解く"
  :help "グラフ（EDN）から、nourishment・depletion・取りの重さの上位を計算します。座標のキーや破壊的な漁法の漁業は、読み込みの時点で退けます。"
  :example seed :raw true
  :run (fn [text] (let [[nodes edges] (a/load-graph text) res (a/analyze nodes edges)]
                    {:top-nourishment (a/rank (:nourishment res) nodes 8)
                     :top-depletion (a/rank (:depletion res) nodes 8)
                     :top-depletion-holders (a/rank (:depletion-out res) nodes 8)}))})

(run/register!
 {:name "report" :label "報告を作る"
  :help "同じ計算から Markdown の報告を作ります。"
  :example seed :raw true
  :run (fn [text] (let [[nodes edges] (a/load-graph text)] (a/report-md nodes edges (a/analyze nodes edges))))})
