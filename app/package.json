{
  "name": "@itonami/umisachi-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "itonami": {
    "id": "network.itonami.umisachi",
    "title": "Umisachi",
    "storageKey": "itonami.umisachi.v1",
    "description": "海幸 — 海の恵みのグラフ（資源・漁業・物流・市場・圧力）を、この端末で読み解きます。分け合いの広がり（nourishment）と、資源が負う取りの重さ（depletion）を計算し、回復へ回す先を示します。漁場の位置や破壊的な漁法は表現できず、外部へは何も送信しません。",
    "cljsSources": [
      "../methods=>umisachi/methods"
    ],
    "storeId": "network.itonami.umisachi"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "tauri": "tauri",
    "build:desktop": "npm run build && tauri build --no-bundle",
    "build:android": "sh scripts/android-apk.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
